# Stabilization overlay for f9 genotype evaluations.
# Load after base eval profile (and optional deterministic/sample-period overlays).

sim_params:
# Keep deterministic placement and low noise behavior from prior overlays.
placement:1
randinit:0.0
nnoise:0.0
bnoise_struct:0.0
bnoise_vel:0.0

Population:
# Allow settling before performance readout.
stabilperiod:250
initial_perf_measuring:2
killnostable:1000000
stabledist:0.01
