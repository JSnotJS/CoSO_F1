# Minimal settings for evaluating core criteria in standard-eval.
# Intended as a lightweight base profile for Python optimization runs.

sim_params:
expdef:standard-eval
initialgen:X
capacity:0
MaxCreated:1
placement:0
rotation:0
creath:0.1
Energy0:10000.0
feed:0
aging:0
evalcount:2
evalplan:~
:numparts,numjoints,numneurons,numconnections,instances,lifespan,velocity,distance,vertvel,vertpos,fit,fit_stdev,time~
evalsavedata:evaluation
evalsavefile:genos_eval.json
evalprintprogress:0

# Keep all core criteria available; objective is selected in Python.
cr_c:0.0
cr_life:0.0
cr_v:1.0
cr_gl:0.0
cr_joints:0.0
cr_nnsiz:0.0
cr_nncon:0.0
cr_di:0.0
cr_vpos:0.0
cr_vvel:0.0
cr_norm:0
cr_simi:0
cr_nsga:0

# Keep f9 mutations disabled because this optimizer proposes replacements itself.
f9_mut:0.0

GenePool:
name:Genotypes
fitness:return 0.0+this.velocity*1.0;
fitfun:0
fitm:2.0
fitma:2.0

Population:
name:Creatures
energy:1
death:1
initial_nn_active:2
nn_paused:0
perfperiod:100
stabilperiod:100
killnostable:1000000
stabledist:0.01
initial_perf_measuring:2
colmask:1
selfmask:65537
othermask:131073
initial_physics_active:1
initial_self_collisions:0

Population:
name:Food
energy:1
death:1
initial_nn_active:0
nn_paused:1
perfperiod:100
stabilperiod:100
killnostable:1000000
stabledist:0.01
initial_perf_measuring:0
colmask:1
selfmask:131074
othermask:65538
initial_physics_active:1
initial_self_collisions:0
