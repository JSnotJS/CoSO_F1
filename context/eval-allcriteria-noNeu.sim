# Core evaluation profile with neural mutations and neural additions disabled.
# Useful for body-focused optimization runs in f1.

sim_params:
expdef:standard-eval
initialgen:X
capacity:0
MaxCreated:1
placement:0
rotation:0
creath:0.1
Energy0:10000.0
feed:0
aging:0
evalcount:2
evalplan:~
:numparts,numjoints,numneurons,numconnections,instances,lifespan,velocity,distance,vertvel,vertpos,fit,fit_stdev,time~
evalsavedata:evaluation
evalsavefile:genos_eval.json
evalprintprogress:0

cr_c:0.0
cr_life:0.0
cr_v:1.0
cr_gl:0.0
cr_joints:0.0
cr_nnsiz:0.0
cr_nncon:0.0
cr_di:0.0
cr_vpos:0.0
cr_vvel:0.0
cr_norm:0
cr_simi:0
cr_nsga:0

# Disable brain-related mutation operators (f0/f1/f4/fH family).
f0_n_new:0.0
f0_n_del:0.0
f0_n_prp:0.0
f0_c_new:0.0
f0_c_del:0.0
f0_c_wei:0.0
f1_nmNeu:0.0
f1_nmConn:0.0
f1_nmProp:0.0
f1_nmWei:0.0
f1_nmVal:0.0
f4_mut_add_conn:0.0
f4_mut_add_neupar:0.0
f4_mut_modneu_conn:0.0
f4_mut_modneu_weight:0.0
fH_mut_add_neuron:0.0
fH_mut_add_connection:0.0

# Disallow adding any neuron classes.
neuadd_N:0
neuadd_Nu:0
neuadd_G:0
neuadd_Gpart:0
neuadd_T:0
neuadd_Tcontact:0
neuadd_Tproximity:0
neuadd_S:0
neuadd_Constant:0
neuadd_Bend_muscle:0
neuadd_Rotation_muscle:0
neuadd_M:0
neuadd_D:0
neuadd_Fuzzy:0
neuadd_VEye:0
neuadd_VMotor:0
neuadd_Sti:0
neuadd_LMu:0
neuadd_Water:0
neuadd_Energy:0
neuadd_Ch:0
neuadd_ChMux:0
neuadd_ChSel:0
neuadd_Rnd:0
neuadd_Sin:0
neuadd_Delay:0
neuadd_Light:0
neuadd_Nn:0
neuadd_PIDP:0
neuadd_PIDV:0
neuadd_SeeLight:0
neuadd_SeeLight2:0
neuadd_S0:0
neuadd_S1:0
neuadd_Thr:0

GenePool:
name:Genotypes
fitness:return 0.0+this.velocity*1.0;
fitfun:0
fitm:2.0
fitma:2.0

Population:
name:Creatures
energy:1
death:1
initial_nn_active:2
nn_paused:0
perfperiod:100
stabilperiod:100
killnostable:1000000
stabledist:0.01
